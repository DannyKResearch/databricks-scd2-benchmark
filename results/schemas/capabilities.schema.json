{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dbxbench capability matrix (capabilities.json)",
  "type": "object",
  "properties": {
    "generated_at": {
      "type": "string"
    },
    "environment": {
      "type": "object"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "capability",
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "SUPPORTED",
              "UNSUPPORTED",
              "ERROR",
              "NOT_RUN",
              "NOT_APPLICABLE",
              "INFO"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "error_condition": {
            "type": [
              "string",
              "null"
            ]
          },
          "sqlstate": {
            "type": [
              "string",
              "null"
            ]
          },
          "docs": {
            "type": [
              "string",
              "null"
            ]
          },
          "duration_s": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "status"
        ]
      }
    }
  },
  "required": [
    "generated_at",
    "capabilities"
  ]
}
